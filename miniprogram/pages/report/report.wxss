.container { padding: 20rpx; background: #f5f5f5; min-height: 100vh; box-sizing: border-box; }
.form-card { background: #fff; border-radius: 12rpx; padding: 30rpx; }
.row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.label { font-size: 28rpx; color: #333; flex-shrink: 0; width: 180rpx; }
.value { font-size: 28rpx; color: #333; }
.picker { font-size: 28rpx; color: #09bb07; text-align: right; flex: 1; }
.input { flex: 1; text-align: right; font-size: 28rpx; border: 1rpx solid #ddd; border-radius: 8rpx; padding: 8rpx 15rpx; }
.submit-btn { background: #09bb07; color: #fff; margin-top: 40rpx; font-size: 32rpx; }