page {
  background: #f2f4f8;
}
.container {
  padding-bottom: 40rpx;
}

/* ===== 顶部操作栏 ===== */
.top-bar {
  background: linear-gradient(135deg, #07c160, #05a75a);
  padding: 30rpx 32rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}
.top-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.btn-add {
  background: rgba(255, 255, 255, 0.95);
  color: #07c160;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 26rpx;
  border-radius: 32rpx;
  line-height: 1.6;
}
.btn-import {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 26rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  line-height: 1.6;
}

/* ===== 统计条 ===== */
.stat-bar {
  margin: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}
.stat-hw { color: #cf1322; }
.stat-normal { color: #389e0d; }
.stat-label {
  font-size: 24rpx;
  color: #999;
}
.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: #f0f0f0;
}

/* ===== 筛选卡片 ===== */
.filter-card {
  background: #fff;
  margin: 0 24rpx 20rpx;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.filter-label {
  width: 96rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  flex-shrink: 0;
}
.filter-input,
.filter-picker {
  flex: 1;
  height: 66rpx;
  line-height: 66rpx;
  background: #f7f8fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
  color: #333;
}
.filter-picker { color: #666; }
.btn-search,
.btn-reset {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin: 0 8rpx 0 0;
  padding: 0;
}
.btn-search { background: #07c160; color: #fff; }
.btn-reset { background: #fff; color: #666; border: 1rpx solid #ddd; }

/* ===== 列表 ===== */
.list-box { padding: 0 24rpx; }
.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx 26rpx 18rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.head-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag-category {
  background: #fff2e8;
  color: #d46b08;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ffd8a8;
}
.tag-category.normal {
  background: #f4f6f8;
  color: #666;
  border-color: #e2e6ea;
}
.tag-hazard {
  font-size: 22rpx;
  color: #cf1322;
  background: #fff1f0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ffa39e;
}
.head-btns {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.btn-edit { font-size: 26rpx; color: #1677ff; }
.btn-delete { font-size: 26rpx; color: #ff4d4f; }

/* 名称 + 代码行 */
.card-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.card-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  flex: 1;
}
.val-code {
  font-size: 26rpx;
  color: #1677ff;
  font-weight: 600;
  font-family: 'Courier New', monospace;
  background: #e6f4ff;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
.no-code {
  font-size: 22rpx;
  color: #bbb;
  background: #fafafa;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx dashed #e8e8e8;
  flex-shrink: 0;
}

/* 装置/部门副标题 */
.card-sub {
  margin-bottom: 16rpx;
}
.card-sub-text {
  font-size: 24rpx;
  color: #8c8c8c;
  background: #f7f8fa;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

/* 字段行 */
.card-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  border-top: 1rpx dashed #f0f0f0;
}
.row-tag {
  width: 88rpx;
  font-size: 22rpx;
  color: #8c8c8c;
  background: #fafafa;
  border: 1rpx solid #ececec;
  border-radius: 6rpx;
  text-align: center;
  padding: 4rpx 0;
  margin-right: 18rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.row-val {
  flex: 1;
  font-size: 27rpx;
  color: #333;
  line-height: 1.55;
  word-break: break-all;
}
.val-hazard {
  color: #cf1322;
  font-weight: 600;
}
.row-btn {
  font-size: 22rpx;
  color: #1677ff;
  padding: 2rpx 14rpx;
  border: 1rpx solid #91caff;
  border-radius: 6rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.catalog-row {
  background: #f6ffed;
  border-radius: 10rpx;
  padding: 12rpx 14rpx;
  margin: 6rpx 0;
  border: 1rpx solid #d9f7be;
}
.tag-catalog {
  background: #f6ffed;
  border-color: #b7eb8f;
  color: #389e0d;
}
.val-catalog { color: #262626; }

.load-more, .load-end {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 24rpx;
}
.empty {
  text-align: center;
  color: #bbb;
  padding: 120rpx 0;
  font-size: 28rpx;
}

/* ===== 弹窗公共 ===== */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.sheet-close {
  font-size: 34rpx;
  color: #999;
  padding: 4rpx 12rpx;
}

/* ===== 新增表单 ===== */
.sheet-body {
  max-height: 62vh;
  margin-bottom: 32rpx;
}
.form-item {
  margin-bottom: 28rpx;
}
.form-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 14rpx;
}
.req { color: #ff4d4f; }
.form-input,
.form-picker {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  color: #333;
}
.form-picker.placeholder { color: #bbb; }
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 120rpx;
  line-height: 1.6;
}

/* 新增页的危险特性选择（整块按钮式，复用样式） */
.hazard-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.hazard-chip {
  padding: 18rpx 28rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
}
.hazard-chip.active {
  background: #1677ff;
  border-color: #1677ff;
  color: #fff;
  font-weight: 500;
}

/* ===== 编辑弹窗输入 ===== */
.edit-input {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 32rpx;
}
.edit-textarea {
  min-height: 160rpx;
  line-height: 1.6;
}
.btn-save {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 14rpx;
  margin: 0;
}

/* ===== 危险特性多选（编辑弹窗，整块按钮式无方框）===== */
.hazard-options {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 36rpx;
}
.hazard-opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc((100% - 48rpx) / 3);
  padding: 30rpx 10rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.hazard-opt .opt-code {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}
.hazard-opt .opt-name {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}
.hazard-opt.clear-btn {
  width: calc((100% - 48rpx) / 3);
  border-style: dashed;
  border-color: #d9d9d9;
  background: #fff;
}
.hazard-opt.clear-btn .opt-name {
  color: #999;
  margin-top: 0;
}

/* 类别选项 */
.category-options {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 32rpx;
  max-height: 50vh;
  overflow-y: auto;
}
.category-opt {
  padding: 16rpx 26rpx;
  background: #fafafa;
  border: 1rpx solid #e8e8e8;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #333;
}
.category-opt.active {
  background: #e6f4ff;
  border-color: #1677ff;
  color: #1677ff;
  font-weight: 500;
}
